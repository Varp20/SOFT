{
  "name": "shopping-cart-project",
  "version": "1.0.0",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "cross-env NODE_ENV=test jest",
    "cypress:open": "cross-env NODE_ENV=test cypress open",
    "cypress:run": "cross-env NODE_ENV=test cypress run",
    "load": "artillery run artillery.yml",
    "load-test": "artillery run artillery.yml && npm run db:reset-test",
    "db:reset-test": "cross-env NODE_ENV=test node -e \"const {pool} = require(\\\"./src/server\\\"); pool.query(\\\"TRUNCATE TABLE shopping_carts RESTART IDENTITY CASCADE\\\").then(() => process.exit())\""
  },
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "artillery": "^2.0.16",
    "cross-env": "^10.1.0",
    "cypress": "^13.6.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.4"
  }
}
